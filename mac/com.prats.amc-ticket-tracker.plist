<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent template for running the watcher on an always-on Mac.

  Install:
    1. Copy to ~/Library/LaunchAgents/com.prats.amc-ticket-tracker.plist
    2. Replace __NTFY_TOPIC__, __UV_PATH__ (`which uv`), __REPO_DIR__, __HOME__.
    3. Load it:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.prats.amc-ticket-tracker.plist
    4. Check:   launchctl list | grep amc-ticket-tracker      (PID = running)
       Logs:    ~/Library/Logs/amc-ticket-tracker.log
    5. Restart after code/config changes:
         launchctl kickstart -k gui/$(id -u)/com.prats.amc-ticket-tracker
    6. Stop/remove:
         launchctl bootout gui/$(id -u)/com.prats.amc-ticket-tracker
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prats.amc-ticket-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>python</string>
        <string>-m</string>
        <string>amc_watch</string>
        <string>--forever</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>NTFY_TOPIC</key>
        <string>__NTFY_TOPIC__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/amc-ticket-tracker.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/amc-ticket-tracker.log</string>
</dict>
</plist>
